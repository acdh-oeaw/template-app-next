{
	"editor.codeActionsOnSave": {
		"source.fixAll.oxc": "explicit",
		"source.fixAll.stylelint": "explicit"
	},
	"editor.defaultFormatter": "oxc.oxc-vscode",
	"editor.formatOnSave": true,
	"editor.quickSuggestions": {
		"strings": true
	},
	"editor.rulers": [120],
	"emmet.showExpandedAbbreviation": "never",
	"eslint.enable": false,
	"files.associations": {
		"*.css": "tailwindcss"
	},
	"js/ts.experimental.useTsgo": true,
	"js/ts.preferences.autoImportFileExcludePatterns": ["next/router.d.ts", "next/dist/client/router.d.ts"],
	"js/ts.preferences.importModuleSpecifier": "non-relative",
	"js/ts.preferences.preferTypeOnlyAutoImports": true,
	"js/ts.tsdk.promptToUseWorkspaceVersion": true,
	"js/ts.tsdk.path": "./node_modules/@typescript/native-preview/lib",
	"oxc.enable.oxfmt": true,
	"oxc.enable.oxlint": true,
	"oxc.requireConfig": true,
	"oxc.typeAware": true,
	"oxc.unusedDisableDirectives": "deny",
	"prettier.enable": false,
	"search.exclude": {
		"pnpm-lock.yaml": true
	},
	"tailwindCSS.classFunctions": ["cn", "styles"],
	"tailwindCSS.validate": true,
	"typescript.native-preview.tsdk": "/home/stefan/development/acdh-oeaw/template-app-next/node_modules/@typescript/native-preview",
	"[markdown]": {
		"editor.wordWrap": "on"
	}
}
