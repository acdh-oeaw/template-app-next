## .gitignore ##

# dependencies
node_modules/
.pnpm-store/

# logs
*.log

# non-public environment variables
.env.keys
.env.local
.env.*.local
/docker/.env

# caches
.cache/
.stylelintcache
*.tsbuildinfo

# turborepo
.turbo/

# performance profiles
*.cpuprofile
*.heapprofile
*.heapsnapshot

# vercel
.vercel

# misc
.DS_Store
*.pem
.idea/

# next.js
.next/
next-env.d.ts
out/

# i18n
*.d.json.ts

# package build artefacts
dist/

# self-signed certificates
certificates/

# test
coverage/

# playwright
blob-report/
playwright/.cache/
playwright-report/
test-results/

# storybook
storybook-static/


## .dockerignore ##

# git
.git/
.gitattributes
# must be allowed because `tailwindcss` v4 will use `.gitignore` to determine which
# files and folders can be skipped by the compiler.
# .gitignore

# github
.github/

# vscode settings
.vscode/

# environment variables
.env
.env.*

# tests
/e2e/
/test/

# misc
.editorconfig
codeowners

# ai
.agents/
.claude/
.codex
.pi/
.playwright-cli/
AGENTS.md
CLAUDE.md
opensrc/
skills-lock.json
