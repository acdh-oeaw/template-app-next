{
	"name": "template-app-next",
	"dockerComposeFile": ["docker-compose.yaml"],
	"service": "app",
	"workspaceFolder": "/workspace",
	"postCreateCommand": {
		// "global": "pnpm add --global bun turborepo",
		"init": "pnpm install && pnpm exec playwright install"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"bradlc.vscode-tailwindcss",
				"EditorConfig.EditorConfig",
				"github.vscode-github-actions",
				"mikestead.dotenv",
				"mrorz.language-gettext",
				"ms-playwright.playwright",
				"oven.bun-vscode",
				"oxc.oxc-vscode",
				"stylelint.vscode-stylelint",
				"TypeScriptTeam.native-preview"
			]
		}
	},
	"forwardPorts": [3000],
	"portsAttributes": {
		"3000": {
			"label": "App"
		}
	},
	"remoteUser": "bun"
}
