{
	"$schema": "https://www.schemastore.org/package.json",
	"name": "@acdh-oeaw/template-app-next",
	"private": true,
	"license": "MIT",
	"type": "module",
	"imports": {
		"#/*": "./*"
	},
	"scripts": {
		"analyze": "bun run --bun next experimental-analyze",
		"build": "bun run --bun next build",
		"dev": "bun run --bun next dev",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt --write",
		"lint:check": "bun run --parallel lint:code:check lint:styles:check",
		"lint:code:check": "oxlint --report-unused-disable-directives --type-aware --type-check",
		"lint:code:fix": "oxlint --fix --report-unused-disable-directives --type-aware --type-check",
		"lint:fix": "bun run --parallel lint:code:fix lint:styles:fix",
		"lint:styles:check": "stylelint \"./**/*.css\" --cache --ignore-path ./.gitignore",
		"lint:styles:fix": "stylelint \"./**/*.css\" --cache --fix --ignore-path ./.gitignore",
		"prepare": "bun run types:prepare",
		"start": "bun run --bun next start",
		"test:e2e": "playwright test --config ./e2e/playwright.config.ts",
		"test:e2e:codegen": "playwright codegen",
		"test:e2e:install": "playwright install --with-deps",
		"test:e2e:ui": "playwright test --config ./e2e/playwright.config.ts --ui",
		"test:e2e:update-snapshots": "playwright test --config ./e2e/playwright.config.ts --update-snapshots",
		"test:unit": "bun test",
		"test:unit:watch": "bun test --watch",
		"types:check": "tsgo --noEmit",
		"types:prepare": "ENV_VALIDATION=\"disabled\" bun run --bun next typegen"
	},
	"dependencies": {
		"@acdh-oeaw/color-schemes": "^0.1.0",
		"@acdh-oeaw/lib": "^1.0.7",
		"@internationalized/date": "^3.12.2",
		"@valibot/i18n": "^1.2.0",
		"better-result": "^2.9.2",
		"client-only": "^0.0.1",
		"clsx": "^2.1.1",
		"next": "^16.2.7",
		"next-intl": "^4.13.0",
		"react": "^19.2.7",
		"react-aria-components": "^1.18.0",
		"react-dom": "^19.2.7",
		"react-schemaorg": "^2.0.1",
		"server-only": "^0.0.1",
		"sharp": "^0.34.5",
		"valibot": "^1.4.1",
		"xast-util-feed": "^2.0.0",
		"xast-util-to-xml": "^4.0.0"
	},
	"devDependencies": {
		"@dotenvx/dotenvx": "^1.71.0",
		"@playwright/test": "^1.60.0",
		"@react-aria/test-utils": "1.0.0-rc.0",
		"@tailwindcss/postcss": "^4.3.0",
		"@types/bun": "^1.3.14",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@typescript/native-preview": "latest",
		"axe-core": "^4.12.0",
		"axe-playwright": "^2.2.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint-plugin-better-tailwindcss": "^4.5.0",
		"eslint-plugin-playwright": "^2.10.4",
		"eslint-plugin-regexp": "^3.1.0",
		"is-in-ci": "^2.0.0",
		"lefthook": "^2.1.9",
		"null-loader": "^4.0.1",
		"oxfmt": "^0.53.0",
		"oxlint": "^1.68.0",
		"oxlint-tsgolint": "^0.23.0",
		"po-parser": "^2.1.1",
		"schema-dts": "^2.0.0",
		"stylelint": "^17.13.0",
		"stylelint-order": "^8.1.1",
		"tailwindcss": "^4.3.0",
		"tailwindcss-react-aria-components": "^2.1.1",
		"tw-animate-css": "^1.4.0"
	},
	"stylelint": {},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^11.1.2",
			"onFail": "download"
		},
		"runtime": {
			"name": "bun",
			"version": "^1.3.14",
			"onFail": "download"
		}
	},
	"engines": {
		"runtime": {
			"name": "bun",
			"version": "^1.3.14",
			"onFail": "download"
		}
	},
	"postcss": {
		"plugins": {
			"@tailwindcss/postcss": {}
		}
	}
}
