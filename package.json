{
	"$schema": "https://www.schemastore.org/package",
	"name": "@acdh-oeaw/template-app-next",
	"private": true,
	"license": "MIT",
	"type": "module",
	"imports": {
		"#/*": "./*"
	},
	"scripts": {
		"analyze": "bun run --bun next experimental-analyze",
		"build": "bun run --bun next build",
		"dev": "bun run --bun next dev",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt --write",
		"lint:check": "bun run --parallel lint:code:check lint:styles:check",
		"lint:code:check": "oxlint --report-unused-disable-directives --type-aware --type-check",
		"lint:code:fix": "oxlint --fix --report-unused-disable-directives --type-aware --type-check",
		"lint:fix": "bun run --parallel lint:code:fix lint:styles:fix",
		"lint:styles:check": "stylelint \"./**/*.css\" --cache --ignore-path ./.gitignore",
		"lint:styles:fix": "stylelint \"./**/*.css\" --cache --fix --ignore-path ./.gitignore",
		"prepare": "bun run types:prepare",
		"start": "bun run --bun next start",
		"test:e2e": "playwright test --config ./e2e/playwright.config.ts",
		"test:e2e:codegen": "playwright codegen",
		"test:e2e:install": "playwright install --with-deps",
		"test:e2e:ui": "bun run test:e2e --ui",
		"test:e2e:update-snapshots": "bun run test:e2e --update-snapshots",
		"types:check": "tsc --noEmit",
		"types:prepare": "ENV_VALIDATION=\"disabled\" bun run --bun next typegen"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^1.0.7",
		"@internationalized/date": "^3.12.2",
		"@valibot/i18n": "^1.2.0",
		"better-result": "^2.10.0",
		"client-only": "^0.0.1",
		"clsx": "^2.1.1",
		"next": "^16.3.0-preview.7",
		"next-intl": "^4.13.3",
		"nodemailer": "^9.0.3",
		"react": "^19.2.8",
		"react-aria-components": "^1.19.0",
		"react-dom": "^19.2.8",
		"react-schemaorg": "^2.0.1",
		"server-only": "^0.0.1",
		"sharp": "^0.35.3",
		"tw-animate-css": "^1.4.0",
		"typesense": "^3.0.6",
		"valibot": "^1.4.2",
		"xast-util-feed": "^2.0.0",
		"xast-util-to-xml": "^4.0.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.61.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/bun": "^1.3.14",
		"@types/nodemailer": "^8.0.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"axe-core": "^4.12.1",
		"axe-playwright": "^2.2.2",
		"eslint-plugin-better-tailwindcss": "^4.7.0",
		"eslint-plugin-playwright": "^2.10.5",
		"eslint-plugin-regexp": "^3.1.1",
		"eslint-plugin-storybook": "^10.5.3",
		"eslint-plugin-tailwindcss": "^4.2.0",
		"is-in-ci": "^2.0.0",
		"lefthook": "^2.1.10",
		"null-loader": "^4.0.1",
		"oxfmt": "^0.60.0",
		"oxlint": "^1.75.0",
		"oxlint-tsgolint": "^7.0.2001",
		"schema-dts": "^2.0.0",
		"stylelint": "^17.14.1",
		"stylelint-order": "^8.1.1",
		"tailwindcss": "^4.3.3",
		"tailwindcss-react-aria-components": "^2.2.0",
		"typescript": "^7.0.2"
	},
	"stylelint": {
		"extends": "./configs/stylelint/base.json"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^11.15.1",
			"onFail": "download"
		},
		"runtime": {
			"name": "bun",
			"version": "^1.3.14",
			"onFail": "download"
		}
	},
	"engines": {
		"runtime": {
			"name": "bun",
			"version": "^1.3.14",
			"onFail": "download"
		}
	},
	"postcss": {
		"plugins": {
			"@tailwindcss/postcss": {}
		}
	}
}
