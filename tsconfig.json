{
	"$schema": "https://www.schemastore.org/tsconfig.json",
	"compilerOptions": {
		"allowArbitraryExtensions": true,
		"allowImportingTsExtensions": true,
		"allowJs": false,
		"exactOptionalPropertyTypes": false,
		"incremental": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"lib": ["dom", "esnext"],
		"module": "preserve",
		"moduleDetection": "force",
		"noEmit": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"noPropertyAccessFromIndexSignature": false,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		/** @see {@link https://github.com/oven-sh/bun/issues/28995} */
		"paths": {
			"#/*": ["./*"]
		},
		"plugins": [{ "name": "next" }],
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "esnext",
		"types": ["bun", "react", "react-dom"],
		"verbatimModuleSyntax": true
	},
	/** Next.js adds the `.next/test` entries in test builds, which are excluded to keep test routes out of route types. */
	"include": [
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		".next/test/types/**/*.ts",
		".next/test/dev/types/**/*.ts"
	],
	"exclude": [".next/test", "dist", "node_modules", "out", "public", "storybook-static"]
}
